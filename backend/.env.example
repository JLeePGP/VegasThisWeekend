# Copy to .env for local development. Never commit .env.
# Production values live in Railway environment variables.

ENVIRONMENT=development

# Local dev uses SQLite so no database service is required.
# Railway injects the real value: postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///./vegasthisweekend.db

# Exact origins only, comma-separated. In production this is https://vegasthisweekend.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phase 2: admin panel + AI URL extraction (not used by the v1 consumer app) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
ANTHROPIC_API_KEY=
EVENTBRITE_API_KEY=

# --- Tunables ---
SHARE_TTL_DAYS=30
MAX_SHARE_EVENTS=20
PAGE_SIZE=20
