# Copy to .env for local development. Never commit .env.
# Production values live in Railway environment variables.

ENVIRONMENT=development

# Local dev uses SQLite so no database service is required.
# Railway injects the real value: postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///./vegasthisweekend.db

# Exact origins only, comma-separated. 5173 is the public app, 5174 the admin panel.
# In production this is https://vegasthisweekend.com plus http://localhost:5174, since
# the admin panel runs locally against the deployed API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Admin panel ---
# Every /admin route requires this as a bearer token. An empty value disables those
# routes entirely rather than leaving them open.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- AI URL extraction ---
# Without this, the admin panel still works — manual entry only.
#
# NOTE: an API key is not the same thing as a Claude Pro subscription. Pro covers
# claude.ai; API usage is billed separately against credits on your Anthropic Console
# account. Create the key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Cloudflare R2 (event images) ---
# All five must be set before image mirroring turns on. Until then, events keep the
# client-side generated posters and nothing breaks.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Eventbrite (not yet wired up) ---
EVENTBRITE_API_KEY=

# --- Tunables ---
SHARE_TTL_DAYS=30
MAX_SHARE_EVENTS=20
PAGE_SIZE=20
MAX_SERIES_OCCURRENCES=26
MAX_IMAGE_BYTES=10000000
