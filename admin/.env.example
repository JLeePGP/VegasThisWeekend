# Copy to .env.
#
# Which API the admin panel writes to. Local backend while you're testing; the Railway
# origin once you're seeding real events.
#   local:      http://127.0.0.1:8000
#   production: https://api.vegasthisweekend.com
#
# Use the custom domain for production, never the raw *.up.railway.app hostname. Requests
# to the custom domain go through Cloudflare and pick up the shared secret its Transform
# Rule injects; requests straight to Railway do not. Once REQUIRE_PROXY_SECRET is on (see
# OPERATIONS.md § 4) the raw hostname returns 403 to everything, and this panel would be
# the first thing to break.
#
# The admin token is NOT set here — it is typed into the panel and kept in the
# browser's localStorage, so it never lands in a file on disk.
VITE_API_BASE_URL=http://127.0.0.1:8000
