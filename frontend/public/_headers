/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://plausible.io; connect-src 'self' https://api.vegasthisweekend.com https://plausible.io; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests

# CSP notes:
#
# connect-src listed the raw railway.app origin as well during the cutover to the custom
# API domain, because the CSP ships in this repo while VITE_API_BASE_URL lives in Netlify's
# settings — the two cannot change in the same instant. The deployed bundle was confirmed
# calling api.vegasthisweekend.com only, so that entry is gone.
#
# Getting this wrong is unusually unpleasant to debug: a blocked request surfaces as a CSP
# violation in the console, not a network error, so the API looks healthy while the site
# looks broken. If you point the frontend at a new API origin, change it here in the same
# commit.
#
# script-src does NOT allow static.cloudflareinsights.com. Cloudflare Web Analytics
# auto-injects a beacon from there, so enabling it in the Cloudflare dashboard would fail
# silently until this line changes. Cloudflare's own traffic dashboard needs no script and
# works regardless.
#
# img-src allows any https host because event images come from ticketing sites and venue
# CDNs, and Cloudflare R2 is not configured yet. The trade-off is that loading a
# third-party image reveals the visitor's IP to that host — a small inconsistency with
# this app's otherwise cookieless, no-PII stance. Once R2 is set up and images are
# mirrored, tighten this to `img-src 'self' data: https://<your-r2-domain>` and the app
# stops talking to third parties entirely. Events without a usable image fall back to a
# locally generated poster, so tightening it breaks nothing visually.

# Hashed build assets are immutable; the HTML shell must never be cached.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
